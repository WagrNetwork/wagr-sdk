{
  "name": "@stellar/wagr-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Wagr Protocol — match orchestration and result adapters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./adapters/*": {
      "import": "./dist/adapters/*.mjs",
      "require": "./dist/adapters/*.js",
      "types": "./dist/adapters/*.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && tsx scripts/bundle.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "dev": "vitest --watch"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "tsx": "^4.0.0"
  },
  "keywords": [
    "wagr",
    "soroban",
    "stellar",
    "wagering",
    "escrow",
    "chess",
    "gaming"
  ],
  "author": "Wagr Protocol Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar/wagr-sdk"
  }
}
